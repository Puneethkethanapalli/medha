 data;\n        }\n      } catch {\n        // Nothing we can do\n      }\n    } finally {\n      fetchPromise = null;\n    }\n  })", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L62"}, {"caller_nid": "litellm_registry_getlitellmcapabilities", "callee": "capabilitiesFromMetadata", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L148"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "replace", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L183"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "add", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L188"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "add", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L189"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "add", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L193"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "indexOf", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L196"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "slice", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L198"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "slice", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L199"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "add", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L202"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "add", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L206"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "add", "source_file": "src/lib/models/litellm-registry.ts", "source_location": "L208"}, {"caller_nid": "litellm_registry_getlookupkeys", "callee": "add", "source_file": "src/lib/models/litellm-registry.ts", "source_