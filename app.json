{
  "expo": {
    "name": "medha",
    "slug": "medha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/medha-app-icon.png",
    "scheme": "medhatemp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/medha-app-icon.png",
      "bundleIdentifier": "com.puneethkth.medha"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/images/medha-mark.png",
        "monochromeImage": "./assets/images/medha-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.puneethkth.medha"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/medha-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/images/medha-mark.png",
          "imageWidth": 104,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      ["expo-speech-recognition", {
        "microphonePermission": "Allow Medha to use your microphone for voice input.",
        "speechRecognitionPermission": "Allow Medha to use speech recognition.",
        "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
      }],
      "expo-image-picker",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
